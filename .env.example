# Cópia para .env. Todas as variáveis têm padrão seguro; só altere o necessário.
PORT=8791
HOST=127.0.0.1
DB_PATH=./data/partidou.db
LOG_DIR=./logs
# cloudflare quando o tráfego chega pelo túnel da Cloudflare; nenhum caso contrário.
TRUST_PROXY=
# Endereços de proxy em quem se confia para ler CF-Connecting-IP. Padrão: loopback.
# No Docker, o gateway da rede do compose (ver compose.yaml).
PROXY_CONFIAVEL=
